# Example environment configuration for MFE application

# Set to 'true' to build for GitHub Pages deployment
# Automatically set by GitHub Actions CI/CD pipeline
GITHUB_PAGES=false

# GitHub repository in format: username/repo-name
# Automatically set by GitHub Actions CI/CD pipeline
# GITHUB_REPOSITORY=username/mfe

# Node environment
NODE_ENV=development

# Port for Express server (local development only)
PORT=3000
