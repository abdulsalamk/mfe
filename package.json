{
  "name": "mfe-website",
  "version": "1.0.0",
  "description": "Micro Front End website using Module Federation",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"npm run dev:host\" \"npm run dev:left\" \"npm run dev:middle\" \"npm run dev:right\"",
    "dev:host": "webpack serve --config webpack.host.js --mode development",
    "dev:left": "webpack serve --config webpack.left.js --mode development",
    "dev:middle": "webpack serve --config webpack.middle.js --mode development",
    "dev:right": "webpack serve --config webpack.right.js --mode development",
    "build": "npm run build:host && npm run build:left && npm run build:middle && npm run build:right",
    "build:host": "webpack --config webpack.host.js --mode production",
    "build:left": "webpack --config webpack.left.js --mode production",
    "build:middle": "webpack --config webpack.middle.js --mode production",
    "build:right": "webpack --config webpack.right.js --mode production"
  },
  "keywords": [
    "micro-frontend",
    "module-federation",
    "webpack"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "@babel/preset-react": "^7.22.0",
    "babel-loader": "^9.1.2",
    "concurrently": "^8.2.0",
    "html-webpack-plugin": "^5.5.3",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  }
}
